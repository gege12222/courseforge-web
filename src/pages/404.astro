---
/**
 * One 404 for both languages: Cloudflare serves /404.html for any unmatched
 * path, including under /hu/, so it cannot know the locale. Both languages are
 * shown rather than guessing wrong.
 */
import { LOCALES, routePath } from '../config/site.ts';
import { useTranslations } from '../i18n/index.ts';
import Base from '../layouts/Base.astro';

const t = useTranslations('en');
---

<Base locale="en" routeId="home" title={t.notFound.title} description={t.notFound.description} noindex>
  <div class="mx-auto max-w-cf px-gutter py-16 sm:px-5">
    <p class="font-display text-6xl font-bold text-gold">404</p>
    {
      LOCALES.map((locale) => {
        const strings = useTranslations(locale);
        return (
          <section class="mt-8 max-w-measure" lang={strings.meta.htmlLang}>
            <h1 class="text-2xl">{strings.notFound.heading}</h1>
            <p class="mt-2 text-ink-muted">{strings.notFound.lead}</p>
            <p class="mt-3">
              <a
                href={routePath('home', locale)}
                class="font-display font-bold text-navy underline decoration-[var(--cf-gold)] underline-offset-4"
              >
                {strings.notFound.cta} →
              </a>
            </p>
          </section>
        );
      })
    }
  </div>
</Base>
