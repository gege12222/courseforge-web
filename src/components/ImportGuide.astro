---
/**
 * The honest three-step import flow. Tapping a course file does not open
 * CourseForge yet — the app registers no file type with either OS (AUDIT.md
 * §1c) — so this describes what actually happens, with the iOS and Android
 * paths called out separately because the iOS one through Files is the
 * confusing one.
 */
import { type Locale } from '../config/site.ts';
import { useTranslations } from '../i18n/index.ts';

interface Props {
  locale: Locale;
  class?: string;
}

const { locale, class: className } = Astro.props;
const t = useTranslations(locale);
---

<section class:list={['rounded-xl border border-line bg-surface p-card sm:p-6', className]} aria-labelledby="import-title">
  <h2 id="import-title" class="font-display text-lg">{t.importGuide.title}</h2>
  <p class="mt-1.5 text-sm text-ink-muted">{t.importGuide.lead}</p>

  <ol class="mt-4 flex flex-col gap-3">
    {
      t.importGuide.steps.map((step, index) => (
        <li class="flex gap-3">
          <span
            class="mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-pill bg-navy font-display text-xs font-bold text-cream"
            aria-hidden="true"
          >
            {index + 1}
          </span>
          <span class="text-sm text-ink">{step}</span>
        </li>
      ))
    }
  </ol>

  <dl class="mt-5 grid gap-3 border-t border-line-soft pt-4 text-sm sm:grid-cols-2">
    <div>
      <dt class="font-display font-bold text-navy">iOS</dt>
      <dd class="mt-0.5 text-ink-muted">{t.importGuide.ios}</dd>
    </div>
    <div>
      <dt class="font-display font-bold text-navy">Android</dt>
      <dd class="mt-0.5 text-ink-muted">{t.importGuide.android}</dd>
    </div>
  </dl>

  <p class="mt-4 rounded-md bg-warm-surface px-3 py-2 text-xs text-ink-muted">{t.importGuide.note}</p>
</section>
