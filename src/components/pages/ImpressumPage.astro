---
/**
 * Impresszum — required for a commercial online service under the Hungarian
 * E-commerce Act (2001. évi CVIII. törvény, Ekertv. § 4).
 *
 * Labels come from the i18n files, values from BUSINESS in src/config/site.ts —
 * the same values the Terms of Use and the Privacy Policy publish. A row with an
 * empty value still renders as "to be completed" rather than silently vanishing.
 */
import { BUSINESS, type Locale } from '../../config/site.ts';
import { useTranslations } from '../../i18n/index.ts';
import Base from '../../layouts/Base.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const fields: { label: string; value: string; mailto?: boolean }[] = [
  { label: t.impressum.fields.name, value: BUSINESS.name },
  { label: t.impressum.fields.address, value: BUSINESS.address },
  { label: t.impressum.fields.taxNumber, value: BUSINESS.taxNumber },
  { label: t.impressum.fields.registrationNumber, value: BUSINESS.registrationNumber },
  { label: t.impressum.fields.registrationAuthority, value: BUSINESS.registrationAuthority },
  { label: t.impressum.fields.email, value: BUSINESS.email, mailto: true },
];
---

<Base {locale} routeId="impressum" title={t.impressum.title} description={t.impressum.description}>
  <div class="mx-auto max-w-cf px-gutter py-10 sm:px-5">
    <h1 class="text-3xl sm:text-4xl">{t.impressum.title}</h1>
    <p class="mt-3 max-w-measure text-ink-muted">{t.impressum.lead}</p>

    <dl class="mt-8 max-w-measure rounded-xl border border-line bg-surface">
      {
        fields.map((field) => (
          <div class="flex flex-col gap-1 border-b border-line-soft px-card py-3 last:border-0 sm:flex-row sm:items-baseline sm:gap-4">
            <dt class="w-56 shrink-0 font-display text-sm font-bold text-navy">{field.label}</dt>
            <dd class="text-sm text-ink">
              {
                !field.value ? (
                  <span class="italic text-ink-faint">{t.impressum.pending}</span>
                ) : field.mailto ? (
                  <a
                    href={`mailto:${field.value}`}
                    class="text-navy underline decoration-[var(--cf-gold)] underline-offset-4"
                  >
                    {field.value}
                  </a>
                ) : (
                  field.value
                )
              }
            </dd>
          </div>
        ))
      }
    </dl>

    <section class="mt-8 max-w-measure">
      <h2 class="font-display text-lg">{t.impressum.hosting}</h2>
      <p class="mt-1.5 text-sm text-ink-muted">{t.impressum.hostingBody}</p>
    </section>
  </div>
</Base>
