---
import { getEntry, render } from 'astro:content';
import { CONTACT_EMAIL, routePath, type Locale, type RouteId } from '../../config/site.ts';
import { formatDate, useTranslations } from '../../i18n/index.ts';
import Base from '../../layouts/Base.astro';
import Prose from '../Prose.astro';

interface Props {
  locale: Locale;
  /** 'privacy' | 'terms' | 'cookies' — matches both the route id and the file. */
  doc: Extract<RouteId, 'privacy' | 'terms' | 'cookies'>;
}

const { locale, doc } = Astro.props;
const t = useTranslations(locale);

const entry = await getEntry('legal', `${locale}/${doc}`);
if (!entry) throw new Error(`Missing legal document src/content/legal/${locale}/${doc}.md`);
const { Content } = await render(entry);
---

<Base {locale} routeId={doc} title={entry.data.title} description={entry.data.description}>
  <div class="mx-auto max-w-cf px-gutter py-10 sm:px-5">
    <h1 class="text-3xl sm:text-4xl">{entry.data.title}</h1>

    {
      entry.data.reviewNotice && (
        <p class="mt-4 max-w-measure rounded-md border border-line bg-warm-surface px-4 py-3 text-sm text-ink">
          <strong class="font-display">⚠︎</strong> {t.legal.reviewNotice}
        </p>
      )
    }

    <p class="mt-3 text-sm text-ink-faint">
      {t.legal.lastUpdated}: <time datetime={entry.data.updated.toISOString()}>{formatDate(entry.data.updated, locale)}</time>
    </p>

    <Prose class="mt-6" wide>
      <Content />
    </Prose>

    <p class="mt-10 max-w-measure-wide text-sm text-ink-muted">
      {t.legal.contact}{' '}
      <a href={`mailto:${CONTACT_EMAIL}`} class="text-navy underline decoration-[var(--cf-gold)] underline-offset-4">
        {CONTACT_EMAIL}
      </a>
      {' · '}
      <a href={routePath('impressum', locale)} class="text-navy underline decoration-[var(--cf-gold)] underline-offset-4">
        {t.footer.impressum}
      </a>
    </p>
  </div>
</Base>
