---
import { routePath, type Locale } from '../../config/site.ts';
import { useTranslations } from '../../i18n/index.ts';
import { softwareApplicationSchema } from '../../lib/seo.ts';
import Base from '../../layouts/Base.astro';
import CardArt from '../CardArt.astro';
import HeroScene from '../HeroScene.astro';
import StoreBadges from '../StoreBadges.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

/** Parallel to t.home.what — the art for each card, in the same order. */
const CARD_ART = ['arena', 'place', 'distance', 'export'] as const;
---

<Base
  {locale}
  routeId="home"
  title={t.home.title}
  description={t.home.description}
  schema={[softwareApplicationSchema(locale, t.home.description)]}
>
  {/* ------------------------------------------------------------------ hero */}
  <section class="border-b border-line-soft bg-canvas">
    <div class="mx-auto grid max-w-cf gap-8 px-gutter py-12 sm:px-5 lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:py-16">
      <div class="relative z-10">
        <h1 class="text-3xl sm:text-4xl lg:text-[2.75rem]">{t.home.heroTitle}</h1>
        <p class="mt-4 max-w-measure text-lg text-ink">{t.home.heroLead}</p>
        <p class="mt-2 max-w-measure text-ink-muted">{t.home.heroSub}</p>
        <StoreBadges {locale} class="mt-6" />
      </div>

      <HeroScene label={t.home.heroSceneAlt} class="pointer-events-none select-none" />
    </div>
  </section>

  {/* ------------------------------------------------------------ what it does */}
  <section class="border-b border-line-soft bg-surface">
    <div class="mx-auto max-w-cf px-gutter py-12 sm:px-5">
    <h2 class="text-2xl">{t.home.whatTitle}</h2>
    <ul class="mt-6 grid gap-5 sm:grid-cols-2">
      {
        t.home.what.map((item, index) => (
          <li class="flex flex-col rounded-xl border border-line bg-surface p-card shadow-cf">
            <h3 class="font-display text-base">{item.title}</h3>
            <p class="mt-1.5 flex-1 text-sm text-ink-muted">{item.body}</p>
            <CardArt kind={CARD_ART[index] ?? 'arena'} {locale} class="mt-4" />
          </li>
        ))
      }
    </ul>
    <p class="mt-6">
      <a
        href={routePath('features', locale)}
        class="font-display font-bold text-navy underline decoration-[var(--cf-gold)] underline-offset-4"
      >
        {t.nav.features} →
      </a>
      </p>
    </div>
  </section>

  {/* -------------------------------------------------------------- offline */}
  <section class="mx-auto max-w-cf px-gutter py-12 sm:px-5">
    <div class="rounded-xl bg-navy p-6 text-cream sm:p-8">
      <h2 class="text-2xl text-cream">{t.home.offlineTitle}</h2>
      {t.home.offlineBody.map((paragraph) => (
        <p class="mt-3 text-cream/85">{paragraph}</p>
      ))}
      <p class="mt-5 font-display text-lg font-bold" style="color: var(--cf-gold-on-dark)">
        {t.home.offlineClosing}
      </p>
      <p class="mt-5 text-sm text-cream/70">{t.home.offlineNote}</p>
      <p class="mt-4">
        <a
          href={routePath('privacy', locale)}
          class="font-display font-bold underline decoration-[var(--cf-gold-on-dark)] underline-offset-4"
          style="color: var(--cf-gold-on-dark)"
        >
          {t.footer.privacy} →
        </a>
      </p>
    </div>
  </section>

  <section class="border-t border-line-soft bg-surface">
    <div class="mx-auto max-w-cf px-gutter py-12 sm:px-5">
      <h2 class="text-2xl">{t.home.faqTitle}</h2>
      <dl class="mt-6 max-w-measure-wide space-y-6">
        {t.home.faq.map((item) => (
          <div>
            <dt class="font-display text-lg font-bold text-navy">{item.question}</dt>
            <dd class="mt-2 text-ink-muted">{item.answer}</dd>
          </div>
        ))}
      </dl>
      <nav class="mt-6 flex flex-wrap gap-x-6 gap-y-3" aria-label={t.nav.menu}>
        <a href={routePath('pricing', locale)} class="font-display font-bold text-navy underline underline-offset-4">{t.nav.pricing}</a>
        <a href={routePath('about', locale)} class="font-display font-bold text-navy underline underline-offset-4">{t.nav.about}</a>
      </nav>
    </div>
  </section>

</Base>
